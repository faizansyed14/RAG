# Copy to .env.dev and fill in. .env.dev itself is gitignored.

POSTGRES_DSN=postgresql://rag:change_me@postgres:5432/rag_engine
QDRANT_URL=http://qdrant:6333

S3_ENDPOINT_URL=http://minio:9000
# Browser-reachable endpoint for presigned preview URLs -- "minio" above
# only resolves inside the Docker network. Without this, every document
# preview fails (the browser can't reach the URL at all).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=rag-engine-dev
S3_ACCESS_KEY=rag
S3_SECRET_KEY=change_me

# The tree engine runs local-only (no PageIndex Cloud, no PageIndex API
# key) -- all it needs is OpenRouter for its index/chat models.
OPENROUTER_API_KEY=sk-or-...
RAG_STORAGE_PATH=/app/.rag-data

# Models -- this is the only place they're set; core/config.py has no
# fallback, so the app won't start without all five. See docs/MODELS.md
# for exactly which call site each one drives and how many calls per
# document/query to expect.
RAG_INDEX_MODEL=openai/gpt-4o-mini
RAG_CHAT_MODEL=openai/gpt-5-mini
MODEL_VISION=qwen/qwen3-vl-235b-a22b-instruct
MODEL_EMBEDDING=openai/text-embedding-3-small
MODEL_EMBEDDING_DIMENSION=1536

AUTH_SECRET=dev-only-not-for-prod

# Simple single-admin login -- no user table.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- optional: security / limits (defaults shown; see docs/SECURITY.md) ----
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000   # where presigned file URLs point (CSP img/connect-src)
# ACCESS_TOKEN_TTL_MINUTES=1440
# MAX_UPLOAD_MB=50
# TRUSTED_PROXY_HOPS=0        # set to 1 behind nginx so per-IP limits see the real client address
