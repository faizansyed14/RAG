# Copy to .env.dev and fill in. .env.dev itself is gitignored.
#
# Run compose with --env-file .env.dev (see scripts/dev-start.sh) -- the
# POSTGRES_PASSWORD / MINIO_ROOT_PASSWORD / QDRANT_API_KEY values below are
# read by docker-compose.dev.yml itself (container credentials), separate
# from env_file: .env.dev (what the app containers see at runtime). Both
# need the same value kept in sync by hand -- see POSTGRES_DSN/S3_SECRET_KEY
# below, which must match.

# ---- read by docker compose itself (container credentials) ----
POSTGRES_PASSWORD=change_me
MINIO_ROOT_USER=rag
MINIO_ROOT_PASSWORD=change_me
QDRANT_API_KEY=change_me

# nginx TLS cert dir -- must contain fullchain.pem and privkey.pem.
#   Local dev: generate a throwaway self-signed cert once --
#     mkdir -p infra/nginx/dev-certs && MSYS_NO_PATHCONV=1 openssl req -x509 -nodes \
#       -days 825 -newkey rsa:2048 -keyout infra/nginx/dev-certs/privkey.pem \
#       -out infra/nginx/dev-certs/fullchain.pem -subj "/CN=localhost" \
#       -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
#     then TLS_CERT_DIR=./infra/nginx/dev-certs (browsers will warn -- expected).
#   EC2 with a real domain: point your domain's DNS A record at the instance
#   first, then (with port 80 free -- run this *before* starting the stack):
#     sudo certbot certonly --standalone -d yourdomain.com
#   then TLS_CERT_DIR=/etc/letsencrypt/live/yourdomain.com
#   Renew before it expires (90 days): certbot renew (stop nginx first, or use
#   certbot's webroot mode to avoid downtime).
TLS_CERT_DIR=./infra/nginx/dev-certs

POSTGRES_DSN=postgresql://rag:change_me@postgres:5432/rag_engine
QDRANT_URL=http://qdrant:6333

S3_ENDPOINT_URL=https://minio:9000
# Browser-reachable endpoint for presigned preview URLs. MinIO stays on its
# own port even behind nginx (see docker-compose.dev.yml's minio service
# comment); "minio" above only resolves inside the Docker network.
# https:// -- MinIO reuses the same TLS_CERT_DIR cert as nginx.
# Local: https://localhost:9000 -- EC2: https://yourdomain.com:9000
S3_PUBLIC_ENDPOINT_URL=https://localhost:9000
S3_BUCKET=rag-engine-dev
S3_ACCESS_KEY=rag
S3_SECRET_KEY=change_me

# The tree engine runs local-only (no PageIndex Cloud, no PageIndex API
# key) -- all it needs is OpenRouter for its index/chat models.
OPENROUTER_API_KEY=sk-or-...
RAG_STORAGE_PATH=/app/.rag-data

# Models -- this is the only place they're set; core/config.py has no
# fallback, so the app won't start without all five. See docs/MODELS.md
# for exactly which call site each one drives and how many calls per
# document/query to expect.
RAG_INDEX_MODEL=openai/gpt-4o-mini
RAG_CHAT_MODEL=openai/gpt-5-mini
MODEL_VISION=qwen/qwen3-vl-235b-a22b-instruct
MODEL_EMBEDDING=openai/text-embedding-3-small
MODEL_EMBEDDING_DIMENSION=1536

AUTH_SECRET=dev-only-not-for-prod

# Simple single-admin login -- no user table.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Same origin as the frontend now -- nginx's /api/ route proxies to the
# backend under the same domain/port (443). Local: https://localhost --
# EC2: https://yourdomain.com
NEXT_PUBLIC_API_BASE_URL=https://localhost
CORS_ORIGINS=https://localhost

# ---- optional: security / limits (defaults shown; see docs/SECURITY.md) ----
# NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000   # where presigned file URLs point (CSP img/connect-src)
# ACCESS_TOKEN_TTL_MINUTES=1440
# MAX_UPLOAD_MB=50
# TRUSTED_PROXY_HOPS is set directly in docker-compose.dev.yml's backend
# service now that nginx always fronts this stack -- no need to set it here.
# INGEST_CONCURRENCY=1   # documents indexed at once (1 = strictly one after another)
